@jdic function-mig-post-url:"/executedbmigration","/canceldbmigration"
@jdic function-chat-ai-url:"/aichat"

# this post url is as same as the Jetelina-API is provided to user
@jdic function-japi-url:"/apiactions"

# this post url is for searching 'errnum' in the log file
@jdic function-search-log-errnum-url:"/searcherror"

# get urls for function panel 
@jdic function-get-url:"/getapilist","/getalldbtable","/getconfigchangehistory","/goodbyenow","/getdbsavailability","/getoperationhistory","/getjsjvrelation"
@jdic function-mig-get-url:"/getmigrationtablelist"

# excecution test
@jdic function-dev-test-url:"/autodbtest"

